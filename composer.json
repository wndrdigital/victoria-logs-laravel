{
    "name": "wndr/laravel-victoria-logs-tail",
    "description": "Tail Laravel log files and ship them to VictoriaLogs",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "WNDR Digital"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Wndr\\VictoriaLogsTail\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wndr\\VictoriaLogsTail\\VictoriaLogsTailServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
